# PRODUCTION ENVIRONMENT EXAMPLE — no real secrets here.
# Copy to server .env and fill with owner-supplied values only.
# chmod 600 on the server file.

# SQLite outside deploy directory
DATABASE_URL="file:/var/lib/stroydom/stroydom.db"

# demo | production — use production only with complete legal config
SITE_MODE=production

# Public HTTPS origin (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://example.com

# Telegram — server-side only; messages are lead id + CRM link (no PII fields)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CRM auth — server-side only
# CRM_SESSION_SECRET: openssl rand -base64 32
CRM_PASSWORD=
CRM_SESSION_SECRET=

# Analytics not wired in code — leave empty
NEXT_PUBLIC_METRIKA_ID=

# Required legal / operator fields when SITE_MODE=production
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_STATUS=
LEGAL_INN=
LEGAL_OGRN=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_PHONE=
PRIVACY_CONTACT_EMAIL=
PERSONAL_DATA_RETENTION_DAYS=
PRIVACY_POLICY_VERSION=1.0

NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1
