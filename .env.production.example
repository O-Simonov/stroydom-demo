# PRODUCTION ENVIRONMENT EXAMPLE — no real secrets here.
# Copy to /opt/stroydom/.env on the server and fill in real values.
# File must be readable only by the service user: chmod 600 .env

# SQLite lives OUTSIDE the deploy directory so redeploys never wipe it.
DATABASE_URL="file:/var/lib/stroydom/stroydom.db"

# Public HTTPS origin of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://example.com

# Telegram notifications — server-side only
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Mini-CRM auth — server-side only.
# CRM_PASSWORD: separate password just for /leads (never reuse Telegram token).
# CRM_SESSION_SECRET: long random string used to sign the session cookie.
#   Generate: openssl rand -base64 32
CRM_PASSWORD=
CRM_SESSION_SECRET=

# Optional analytics — leave empty until explicitly enabled
NEXT_PUBLIC_METRIKA_ID=

# Next.js runtime
NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1
