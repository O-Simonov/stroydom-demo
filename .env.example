# Database (local development)
DATABASE_URL="file:./dev.db"

# Site mode: demo | production
# Not a secret. Default behaviour if unset: demo
SITE_MODE=demo

# Public site origin — used for OpenGraph, canonical and sitemap URLs
NEXT_PUBLIC_SITE_URL=

# Telegram notifications — server-side only, never NEXT_PUBLIC_*
# In production, messages contain lead id + CRM link only (no PII fields)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CRM auth — server-side only
CRM_PASSWORD=
CRM_SESSION_SECRET=

# Optional analytics — not connected in code; leave empty
NEXT_PUBLIC_METRIKA_ID=

# ——— Production legal / operator config (required when SITE_MODE=production) ———
# Do NOT invent real values. Fill only with owner-supplied data.
# LEGAL_OPERATOR_STATUS examples: ooo | ip | self_employed | individual | other
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_STATUS=
LEGAL_INN=
# Optional depending on status (ООО/ИП)
LEGAL_OGRN=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_PHONE=
PRIVACY_CONTACT_EMAIL=
# Retention period in days — owner decides; do not invent
PERSONAL_DATA_RETENTION_DAYS=
PRIVACY_POLICY_VERSION=1.0
